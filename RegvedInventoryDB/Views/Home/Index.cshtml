@model RegvedInventoryDB.Models.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Dashboard</h4>
        <small class="text-muted">Real-time inventory overview</small>
    </div>
    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
        <i class="bi bi-circle-fill me-1" style="font-size:.5rem;vertical-align:middle;"></i>
        Live
    </span>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold lh-1">@Model.TotalProducts</div>
                    <small class="text-muted">Total Products</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-info-subtle text-info">
                    <i class="bi bi-tags"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold lh-1">@Model.TotalCategories</div>
                    <small class="text-muted">Categories</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-truck"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold lh-1">@Model.TotalVendors</div>
                    <small class="text-muted">Vendors</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon @(Model.LowStockCount > 0 ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary")">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold lh-1">@Model.LowStockCount</div>
                    <small class="text-muted">Low Stock Items</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Second row: value + recycle bin -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-currency-rupee"></i>
                </div>
                <div>
                    <div class="fs-5 fw-bold lh-1">@Model.TotalInventoryValue.ToString("C0")</div>
                    <small class="text-muted">Total Inventory Value</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-secondary-subtle text-secondary">
                    <i class="bi bi-trash2"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold lh-1">@Model.RecycleBinCount</div>
                    <small class="text-muted">Items in Recycle Bin</small>
                </div>
                @if (Model.RecycleBinCount > 0)
                {
                    <a href="@Url.Action("Index","RecycleBin")" class="btn btn-sm btn-outline-secondary ms-auto">
                        View
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Low Stock Products -->
    <div class="col-md-6">
        <div class="card table-card h-100">
            <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between py-3">
                <span class="fw-semibold">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Low Stock Alert
                </span>
                <a href="@Url.Action("Index","Product")" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.LowStockProducts.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-check-circle-fill text-success fs-2 d-block mb-2"></i>
                        All products are well stocked
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.LowStockProducts)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details","Product", new {id=p.ProductID})" class="text-decoration-none fw-medium">
                                            @p.ProductName
                                        </a>
                                    </td>
                                    <td><span class="badge bg-light text-dark">@p.CategoryName</span></td>
                                    <td>
                                        <span class="badge @(p.Stock == 0 ? "stock-critical" : "stock-low")">
                                            @(p.Stock == 0 ? "Out of Stock" : p.Stock.ToString())
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Recently Added Products -->
    <div class="col-md-6">
        <div class="card table-card h-100">
            <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between py-3">
                <span class="fw-semibold">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Recently Added
                </span>
                <a href="@Url.Action("Create","Product")" class="btn btn-sm btn-primary">+ Add Product</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentProducts.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        No products yet
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.RecentProducts)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details","Product", new {id=p.ProductID})" class="text-decoration-none fw-medium">
                                            @p.ProductName
                                        </a>
                                        <br/><small class="text-muted">@p.CategoryName</small>
                                    </td>
                                    <td class="fw-semibold">@p.Price.ToString("C")</td>
                                    <td>
                                        <span class="badge @(p.Stock == 0 ? "stock-critical" : p.Stock <= 10 ? "stock-low" : "stock-ok")">
                                            @p.Stock
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
