<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? ViewData["Title"]) - Regved IMS</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <!-- DataTables Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <style>
        :root {
            --sidebar-width: 240px;
            --topbar-height: 56px;
            --primary: #0d6efd;
        }

        body { background: #f0f2f5; font-family: 'Segoe UI', system-ui, sans-serif; }

        /* Sidebar */
        .sidebar {
            position: fixed; top: 0; left: 0; bottom: 0;
            width: var(--sidebar-width);
            background: #1e2d3d;
            z-index: 1000;
            overflow-y: auto;
            transition: width .25s ease;
        }
        .sidebar-brand {
            display: flex; align-items: center; gap: .6rem;
            padding: 1rem 1.2rem;
            color: #fff;
            font-size: 1.1rem; font-weight: 700;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }
        .sidebar-brand i { font-size: 1.4rem; color: #4ea8de; }
        .sidebar-nav { padding: .8rem 0; }
        .sidebar-nav .nav-section {
            padding: .35rem 1.2rem;
            font-size: .7rem; font-weight: 600; letter-spacing: .08em;
            color: rgba(255,255,255,.4); text-transform: uppercase;
        }
        .sidebar-nav .nav-link {
            display: flex; align-items: center; gap: .75rem;
            padding: .55rem 1.2rem;
            color: rgba(255,255,255,.75);
            font-size: .88rem;
            border-radius: 0;
            transition: background .15s, color .15s;
        }
        .sidebar-nav .nav-link:hover,
        .sidebar-nav .nav-link.active {
            background: rgba(255,255,255,.1);
            color: #fff;
        }
        .sidebar-nav .nav-link i { width: 1.2rem; font-size: 1rem; }

        /* Main content */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex; flex-direction: column;
        }

        /* Topbar */
        .topbar {
            height: var(--topbar-height);
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
            display: flex; align-items: center;
            padding: 0 1.5rem;
            position: sticky; top: 0; z-index: 900;
        }
        .topbar .breadcrumb { margin-bottom: 0; font-size: .85rem; }

        /* Page content */
        .page-content { padding: 1.5rem; flex: 1; }

        /* Cards */
        .stat-card {
            border: none; border-radius: 12px;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
        }
        .stat-card .card-body { padding: 1.25rem; }
        .stat-icon {
            width: 48px; height: 48px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem;
        }

        /* Tables */
        .table-card {
            border: none; border-radius: 12px;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
            overflow: hidden;
        }
        .table thead th {
            background: #f8f9fa;
            font-size: .8rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: .05em;
            color: #6c757d;
            border-bottom: 1px solid #dee2e6;
        }
        .table td { vertical-align: middle; font-size: .9rem; }

        /* Badges */
        .stock-critical { background: #dc3545 !important; }
        .stock-low      { background: #fd7e14 !important; }
        .stock-ok       { background: #198754 !important; }

        /* Alerts toast */
        .toast-container { z-index: 1100; }

        /* Form cards */
        .form-card {
            border: none; border-radius: 12px;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
            padding: 2rem;
        }

        /* Footer */
        footer { background: #fff; border-top: 1px solid #e5e7eb; padding: .8rem 1.5rem; font-size: .82rem; color: #6c757d; }

        @@media (max-width: 768px) {
            .sidebar { width: 0; overflow: hidden; }
            .main-wrapper { margin-left: 0; }
        }
    </style>
</head>
<body>

<!-- Sidebar -->
<nav class="sidebar">
    <div class="sidebar-brand">
        <i class="bi bi-boxes"></i>
        <span>Regved IMS</span>
    </div>
    <div class="sidebar-nav">
        <div class="nav-section">Main</div>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
           href="@Url.Action("Index","Home")">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <div class="nav-section mt-2">Inventory</div>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")"
           href="@Url.Action("Index","Category")">
            <i class="bi bi-tags"></i> Categories
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")"
           href="@Url.Action("Index","Product")">
            <i class="bi bi-box-seam"></i> Products
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vendor" ? "active" : "")"
           href="@Url.Action("Index","Vendor")">
            <i class="bi bi-truck"></i> Vendors
        </a>

        <div class="nav-section mt-2">System</div>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "RecycleBin" ? "active" : "")"
           href="@Url.Action("Index","RecycleBin")">
            <i class="bi bi-trash2"></i> Recycle Bin
        </a>
    </div>
</nav>

<!-- Main wrapper -->
<div class="main-wrapper">
    <!-- Topbar -->
    <div class="topbar">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Home</a></li>
                @if (ViewBag.BreadcrumbParent != null)
                {
                    <li class="breadcrumb-item">@ViewBag.BreadcrumbParent</li>
                }
                @if ((ViewBag.Title ?? ViewData["Title"]) != null)
                {
                    <li class="breadcrumb-item active">@(ViewBag.Title ?? ViewData["Title"])</li>
                }
            </ol>
        </nav>
    </div>

    <!-- Page content -->
    <main class="page-content">
        <!-- Toast notifications -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="text-center">
        &copy; @DateTime.Now.Year Regved Inventory Management System &mdash; v1.0.0
    </footer>
</div>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmRXAWBQgSMkpHi9FVKyBo6UBa1" crossorigin="anonymous"></script>
<!-- jQuery (required for DataTables) -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<!-- DataTables -->
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<!-- jQuery Validate -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

@RenderSection("Scripts", required: false)
</body>
</html>
