@model RegvedInventoryDB.Models.Product
@{
    ViewBag.Title = "Product Details";
    ViewBag.BreadcrumbParent = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="form-card">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h5 class="fw-bold mb-0">Product Details</h5>
                @if (Model.Stock == 0)
                {
                    <span class="badge stock-critical px-3 py-2">Out of Stock</span>
                }
                else if (Model.Stock <= 10)
                {
                    <span class="badge stock-low px-3 py-2">Low Stock</span>
                }
                else
                {
                    <span class="badge stock-ok px-3 py-2">In Stock</span>
                }
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Product ID</dt>
                <dd class="col-sm-8">@Model.ProductID</dd>

                <dt class="col-sm-4 text-muted">Name</dt>
                <dd class="col-sm-8 fw-semibold fs-5">@Model.ProductName</dd>

                <dt class="col-sm-4 text-muted">Description</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

                <dt class="col-sm-4 text-muted">Category</dt>
                <dd class="col-sm-8"><span class="badge bg-light text-dark border">@Model.CategoryName</span></dd>

                <dt class="col-sm-4 text-muted">Price</dt>
                <dd class="col-sm-8 fw-bold text-success fs-5">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-4 text-muted">Stock</dt>
                <dd class="col-sm-8 fw-bold">@Model.Stock units</dd>

                <dt class="col-sm-4 text-muted">Inventory Value</dt>
                <dd class="col-sm-8 fw-semibold">@((Model.Price * Model.Stock).ToString("C"))</dd>

                <dt class="col-sm-4 text-muted">Manufacture Date</dt>
                <dd class="col-sm-8">@Model.ManufactureDate.ToString("dd MMMM yyyy")</dd>
            </dl>

            <hr />
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.ProductID" class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.ProductID" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>
