@model RegvedInventoryDB.Models.CategoryProductViewModel
@{
    ViewBag.Title = "Edit Product";
    ViewBag.BreadcrumbParent = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="form-card">
            <h5 class="fw-bold mb-1">Edit Product</h5>
            <p class="text-muted small mb-4">Update the product information.</p>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProductModelSingle.ProductID" />
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="ProductModelSingle.ProductName" class="form-label fw-medium"></label>
                        <input asp-for="ProductModelSingle.ProductName" class="form-control" autofocus />
                        <span asp-validation-for="ProductModelSingle.ProductName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="ProductModelSingle.Description" class="form-label fw-medium"></label>
                        <textarea asp-for="ProductModelSingle.Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="ProductModelSingle.Description" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoryID" class="form-label fw-medium">Category</label>
                        <select asp-for="CategoryID" class="form-select"
                                asp-items="@(new SelectList(Model.CategoryModel, "CategoryID", "CategoryName"))">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProductModelSingle.ManufactureDate" class="form-label fw-medium"></label>
                        <input asp-for="ProductModelSingle.ManufactureDate" class="form-control" type="date"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ProductModelSingle.ManufactureDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProductModelSingle.Price" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="ProductModelSingle.Price" class="form-control" type="number"
                                   step="0.01" min="0.01" />
                        </div>
                        <span asp-validation-for="ProductModelSingle.Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProductModelSingle.Stock" class="form-label fw-medium"></label>
                        <input asp-for="ProductModelSingle.Stock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="ProductModelSingle.Stock" class="text-danger small"></span>
                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
