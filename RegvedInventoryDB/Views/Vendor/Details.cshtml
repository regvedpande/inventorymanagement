@model RegvedInventoryDB.Models.Vendor
@{
    ViewBag.Title = "Vendor Details";
    ViewBag.BreadcrumbParent = "Vendors";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="form-card">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h5 class="fw-bold mb-0">Vendor Details</h5>
                <span class="badge bg-success-subtle text-success">Active</span>
            </div>

            <h6 class="text-uppercase text-muted fw-semibold small mb-3">Contact Information</h6>
            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">ID</dt>
                <dd class="col-sm-8">@Model.VendorID</dd>

                <dt class="col-sm-4 text-muted">Vendor Name</dt>
                <dd class="col-sm-8 fw-semibold fs-5">@Model.VendorName</dd>

                <dt class="col-sm-4 text-muted">Description</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

                <dt class="col-sm-4 text-muted">Email</dt>
                <dd class="col-sm-8"><a href="mailto:@Model.VendorEmail">@Model.VendorEmail</a></dd>

                <dt class="col-sm-4 text-muted">Phone</dt>
                <dd class="col-sm-8"><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></dd>

                <dt class="col-sm-4 text-muted">Address</dt>
                <dd class="col-sm-8">@Model.Address</dd>
            </dl>

            <h6 class="text-uppercase text-muted fw-semibold small mb-3">Supply Details</h6>
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Category</dt>
                <dd class="col-sm-8"><span class="badge bg-light text-dark border">@(Model.CategoryName ?? Model.CategoryID.ToString())</span></dd>

                <dt class="col-sm-4 text-muted">Product</dt>
                <dd class="col-sm-8"><span class="badge bg-light text-dark border">@(Model.ProductName ?? Model.ProductID.ToString())</span></dd>

                <dt class="col-sm-4 text-muted">Quantity</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Quantity units</dd>

                <dt class="col-sm-4 text-muted">Price Per Unit</dt>
                <dd class="col-sm-8">@Model.PricePerUnit.ToString("C")</dd>

                <dt class="col-sm-4 text-muted">Total Amount</dt>
                <dd class="col-sm-8 fw-bold text-success fs-5">@Model.Amount.ToString("C")</dd>
            </dl>

            <hr />
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.VendorID" class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.VendorID" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>
