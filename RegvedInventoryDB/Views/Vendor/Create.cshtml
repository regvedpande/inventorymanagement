@model RegvedInventoryDB.Models.VendorCategoryProductViewModel
@{
    ViewBag.Title = "Add Vendor";
    ViewBag.BreadcrumbParent = "Vendors";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="form-card">
            <h5 class="fw-bold mb-1">Add Vendor</h5>
            <p class="text-muted small mb-4">Register a new supplier in the system.</p>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <h6 class="text-uppercase text-muted fw-semibold small mb-3 mt-2">Vendor Information</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="VendorModel.VendorName" class="form-label fw-medium"></label>
                        <input asp-for="VendorModel.VendorName" class="form-control" placeholder="Company or person name" autofocus />
                        <span asp-validation-for="VendorModel.VendorName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="VendorModel.VendorEmail" class="form-label fw-medium"></label>
                        <input asp-for="VendorModel.VendorEmail" class="form-control" type="email" placeholder="contact@example.com" />
                        <span asp-validation-for="VendorModel.VendorEmail" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="VendorModel.PhoneNumber" class="form-label fw-medium"></label>
                        <input asp-for="VendorModel.PhoneNumber" class="form-control" type="tel" placeholder="+91-9876543210" />
                        <span asp-validation-for="VendorModel.PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="VendorModel.Address" class="form-label fw-medium"></label>
                        <input asp-for="VendorModel.Address" class="form-control" placeholder="Full address" />
                        <span asp-validation-for="VendorModel.Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="VendorModel.Description" class="form-label fw-medium"></label>
                        <textarea asp-for="VendorModel.Description" class="form-control" rows="2" placeholder="Optional notes"></textarea>
                        <span asp-validation-for="VendorModel.Description" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />
                <h6 class="text-uppercase text-muted fw-semibold small mb-3">Supply Details</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SelectedCategory" class="form-label fw-medium">Category</label>
                        <select asp-for="SelectedCategory" class="form-select"
                                asp-items="@(new SelectList(Model.CategoryModel, "CategoryID", "CategoryName"))">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="SelectedCategory" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SelectedProduct" class="form-label fw-medium">Product</label>
                        <select asp-for="SelectedProduct" class="form-select"
                                asp-items="@(new SelectList(Model.ProductModel, "ProductID", "ProductName"))">
                            <option value="">-- Select Product --</option>
                        </select>
                        <span asp-validation-for="SelectedProduct" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="VendorModel.Quantity" class="form-label fw-medium"></label>
                        <input asp-for="VendorModel.Quantity" id="quantityInput" class="form-control" type="number" min="1" />
                        <span asp-validation-for="VendorModel.Quantity" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="VendorModel.PricePerUnit" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="VendorModel.PricePerUnit" id="priceInput" class="form-control"
                                   type="number" step="0.01" min="0.01" />
                        </div>
                        <span asp-validation-for="VendorModel.PricePerUnit" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Total Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input id="amountDisplay" class="form-control fw-bold text-success"
                                   type="text" readonly value="0.00" />
                        </div>
                        <small class="text-muted">Auto-calculated</small>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Save Vendor
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var qty   = document.getElementById('quantityInput');
            var price = document.getElementById('priceInput');
            var amt   = document.getElementById('amountDisplay');

            function update() {
                var q = parseFloat(qty.value) || 0;
                var p = parseFloat(price.value) || 0;
                amt.value = (q * p).toFixed(2);
            }
            qty.addEventListener('input', update);
            price.addEventListener('input', update);
            update();
        })();
    </script>
}
